{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SDM",
  "version": "4.0.1",
  "identifier": "com.shayanoh.sdm.tauri",
  "build": {
    "beforeDevCommand": "pnpm --dir web dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shayan's Download Manager",
        "width": 1000,
        "height": 640,
        "minWidth": 760,
        "minHeight": 480,
        "dragDropEnabled": false,
        "label": "main",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "resources": {
      "../../SDMChromeExtension/manifest.json": "chrome-extension/manifest.json",
      "../../SDMChromeExtension/background.js": "chrome-extension/background.js",
      "../../SDMChromeExtension/cookies.js": "chrome-extension/cookies.js",
      "../../SDMChromeExtension/downloads.js": "chrome-extension/downloads.js",
      "../../SDMChromeExtension/version.js": "chrome-extension/version.js",
      "../../SDMChromeExtension/cookie-domains.json": "chrome-extension/cookie-domains.json",
      "../../SDMChromeExtension/options.html": "chrome-extension/options.html",
      "../../SDMChromeExtension/options.js": "chrome-extension/options.js",
      "../../SDMChromeExtension/images/*.png": "chrome-extension/images/",
      "../../LICENSE": "LICENSE",
      "licenses.txt": "licenses.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Shayan Ostadhassan",
    "homepage": "https://github.com/shayanoh/SDM",
    "copyright": "Copyright © 2026 Shayan Ostadhassan",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "category": "Utility",
    "shortDescription": "Fast, resumable download manager",
    "longDescription": "SDM (Shayan's Download Manager) downloads files over several connections at once and resumes them reliably after interruptions or crashes. It grabs links from the clipboard, captures downloads from Chrome through a companion extension, and handles media sites through yt-dlp.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/sdm.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/sdm.desktop"
      }
    }
  }
}
