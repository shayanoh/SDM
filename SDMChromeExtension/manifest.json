{
  "manifest_version": 3,

  "name": "Shayan's Download Manager",
  "description": "Capture downloads from Chrome and send them to SDM.",
  "version": "1.0.1",

  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },

  "key": "",

  "permissions": ["downloads", "nativeMessaging", "storage", "alarms"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
